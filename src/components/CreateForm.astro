<div class="create-container">
  <div class="form-wrapper">
    <h2>Create a README</h2>
    <p class="subtitle">Upload your GitHub repository and let Gittie generate a professional README</p>

    <!-- Error Message -->
    <div id="error-message" class="message error" style="display: none;"></div>
    
    <!-- Success Message -->
    <div id="success-message" class="message success" style="display: none;"></div>

    <!-- Tab Navigation -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="manual">Manual Entry</button>
      <button class="tab-btn" data-tab="github">Import from GitHub</button>
    </div>

    <!-- Manual Entry Tab -->
    <div id="manual-tab" class="tab-content active">
      <!-- GitHub Repo Form -->
      <form class="create-form" id="create-form">
        <div class="form-group">
          <label for="github-username">GitHub Username</label>
          <input 
            id="github-username"
            type="text" 
            placeholder="e.g., octocat" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="repo-name">Repository Name</label>
          <input 
            id="repo-name"
            type="text" 
            placeholder="e.g., hello-world" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="repo-description">Description (Optional)</label>
          <textarea 
            id="repo-description"
            placeholder="Add any additional details about your project..."
            rows="4"
          ></textarea>
        </div>

        <button type="submit" class="btn-submit" id="submit-btn">Generate README</button>
      </form>
    </div>

    <!-- GitHub Import Tab -->
    <div id="github-tab" class="tab-content">
      <div id="github-connect-view">
        <p class="github-info">Connect your GitHub account to easily import repositories and generate READMEs.</p>
        <button type="button" class="btn-github-connect" id="github-connect-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          Connect with GitHub
        </button>
      </div>

      <div id="github-repos-view" style="display: none;">
        <div class="repos-header">
          <h3>Your Repositories</h3>
          <button type="button" class="btn-disconnect" id="disconnect-btn">Disconnect</button>
        </div>
        <div class="repos-search">
          <input 
            type="text" 
            id="repo-search" 
            placeholder="Search repositories..."
          />
        </div>
        <div id="repos-list" class="repos-list"></div>
      </div>
    </div>

    <!-- Generated README Preview -->
    <div id="readme-preview" class="readme-preview" style="display: none;">
      <h3>Generated README Preview</h3>
      <div id="readme-content" class="readme-content"></div>
      <button type="button" class="btn-download" id="download-btn">Download README</button>
      <button type="button" class="btn-create-new" id="create-new-btn">Create Another</button>
    </div>
  </div>
</div>

<style>
.create-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
  padding: 40px 20px;
}

.form-wrapper {
  width: 100%;
  max-width: 600px;
  padding: 40px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  backdrop-filter: blur(10px);
}

.form-wrapper h2 {
  margin-top: 0;
  margin-bottom: 10px;
  color: #fff;
}

.subtitle {
  color: #aaa;
  margin-bottom: 30px;
  font-size: 14px;
}

.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.tab-btn {
  padding: 12px 20px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  color: #aaa;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.3s ease;
  position: relative;
}

.tab-btn:hover {
  color: #ccc;
}

.tab-btn.active {
  color: #00ffcc;
  border-bottom-color: #00ffcc;
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

.message {
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 14px;
}

.message.error {
  background: rgba(255, 69, 69, 0.1);
  color: #ff4545;
  border: 1px solid rgba(255, 69, 69, 0.3);
}

.message.success {
  background: rgba(0, 255, 204, 0.1);
  color: #00ffcc;
  border: 1px solid rgba(0, 255, 204, 0.3);
}

.create-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group label {
  color: #ccc;
  font-size: 14px;
  font-weight: 500;
}

.form-group input,
.form-group textarea {
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: #fff;
  font-family: inherit;
  font-size: 14px;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(0, 255, 204, 0.5);
  box-shadow: 0 0 20px rgba(0, 255, 204, 0.1);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.github-info {
  color: #aaa;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 20px;
  text-align: center;
}

.btn-submit,
.btn-download,
.btn-create-new,
.btn-github-connect {
  padding: 12px 24px;
  background: rgba(0, 255, 204, 0.8);
  border: none;
  border-radius: 8px;
  color: #000;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.btn-submit:hover,
.btn-download:hover,
.btn-github-connect:hover {
  background: rgba(0, 255, 204, 1);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 255, 204, 0.4);
}

.btn-github-connect {
  width: 100%;
}

.btn-create-new {
  background: rgba(255, 255, 255, 0.1);
  color: #00ffcc;
  border: 1px solid rgba(0, 255, 204, 0.3);
}

.btn-create-new:hover {
  background: rgba(0, 255, 204, 0.1);
  border-color: rgba(0, 255, 204, 0.6);
}

.btn-disconnect {
  padding: 8px 12px;
  background: rgba(255, 69, 69, 0.1);
  border: 1px solid rgba(255, 69, 69, 0.3);
  border-radius: 6px;
  color: #ff4545;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-disconnect:hover {
  background: rgba(255, 69, 69, 0.2);
  border-color: rgba(255, 69, 69, 0.6);
}

.repos-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.repos-header h3 {
  color: #fff;
  margin: 0;
}

.repos-search {
  margin-bottom: 20px;
}

.repos-search input {
  width: 100%;
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: #fff;
  font-size: 14px;
  transition: all 0.3s ease;
}

.repos-search input:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(0, 255, 204, 0.5);
  box-shadow: 0 0 20px rgba(0, 255, 204, 0.1);
}

.repos-search input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.repos-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: 400px;
  overflow-y: auto;
}

.repo-item {
  padding: 16px;
  background: rgba(0, 255, 204, 0.05);
  border: 1px solid rgba(0, 255, 204, 0.2);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.repo-item:hover {
  background: rgba(0, 255, 204, 0.1);
  border-color: rgba(0, 255, 204, 0.4);
  transform: translateX(4px);
}

.repo-item-name {
  color: #00ffcc;
  font-weight: 600;
  margin-bottom: 4px;
}

.repo-item-desc {
  color: #aaa;
  font-size: 13px;
  margin-bottom: 8px;
}

.repo-item-meta {
  display: flex;
  gap: 12px;
  font-size: 12px;
  color: #888;
}

.repo-item-meta span {
  display: flex;
  align-items: center;
  gap: 4px;
}

.readme-preview {
  margin-top: 40px;
  padding-top: 40px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.readme-preview h3 {
  color: #fff;
  margin-bottom: 20px;
}

.readme-content {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 20px;
  color: #ccc;
  font-size: 13px;
  line-height: 1.6;
  max-height: 400px;
  overflow-y: auto;
  margin-bottom: 20px;
  white-space: pre-wrap;
  word-break: break-word;
}

.readme-content h1,
.readme-content h2,
.readme-content h3 {
  color: #00ffcc;
  margin-top: 16px;
  margin-bottom: 8px;
}

.btn-submit,
.btn-download {
  display: block;
  width: 100%;
  text-align: center;
}

.btn-create-new {
  width: 100%;
  margin-top: 10px;
}
</style>

<script>
// Manual entry form
const form = document.getElementById('create-form') as HTMLFormElement | null;
const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
const errorMsg = document.getElementById('error-message') as HTMLDivElement | null;
const successMsg = document.getElementById('success-message') as HTMLDivElement | null;
const readmePreview = document.getElementById('readme-preview') as HTMLDivElement | null;
const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement | null;
const createNewBtn = document.getElementById('create-new-btn') as HTMLButtonElement | null;

// GitHub import elements
const tabBtns = document.querySelectorAll('.tab-btn') as NodeListOf<HTMLButtonElement>;
const tabContents = document.querySelectorAll('.tab-content') as NodeListOf<HTMLElement>;
const githubConnectBtn = document.getElementById('github-connect-btn') as HTMLButtonElement | null;
const disconnectBtn = document.getElementById('disconnect-btn') as HTMLButtonElement | null;
const repoSearch = document.getElementById('repo-search') as HTMLInputElement | null;
const reposList = document.getElementById('repos-list') as HTMLDivElement | null;
const githubConnectView = document.getElementById('github-connect-view') as HTMLDivElement | null;
const githubReposView = document.getElementById('github-repos-view') as HTMLDivElement | null;

let currentGitHubToken: string | null = null;
let allRepos: any[] = [];

function showError(message: string) {
  if (errorMsg) {
    errorMsg.textContent = message;
    errorMsg.style.display = 'block';
  }
  if (successMsg) successMsg.style.display = 'none';
}

function showSuccess(message: string) {
  if (successMsg) {
    successMsg.textContent = message;
    successMsg.style.display = 'block';
  }
  if (errorMsg) errorMsg.style.display = 'none';
}

function hideMessages() {
  if (errorMsg) errorMsg.style.display = 'none';
  if (successMsg) successMsg.style.display = 'none';
}

// Tab switching
tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const tabName = btn.getAttribute('data-tab');
    
    // Update active button
    tabBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    // Update active content
    tabContents.forEach(content => content.classList.remove('active'));
    const activeContent = document.getElementById(`${tabName}-tab`);
    if (activeContent) activeContent.classList.add('active');
    
    hideMessages();
  });
});

// Manual form submission
if (form) {
  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    hideMessages();

    const username = (document.getElementById('github-username') as HTMLInputElement)?.value;
    const repoName = (document.getElementById('repo-name') as HTMLInputElement)?.value;
    const description = (document.getElementById('repo-description') as HTMLTextAreaElement)?.value;

    if (!username || !repoName) {
      showError('Please fill in all required fields');
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitBtn) submitBtn.textContent = 'Generating...';

    try {
      const response = await fetch('/api/repos/create-readme', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          githubUsername: username,
          repoName: repoName,
          description: description,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        showError(data.error || 'Failed to generate README');
        return;
      }

      showSuccess('README generated successfully!');
      
      const readmeContent = data.readme;
      (window as any).currentReadme = readmeContent;

      if (readmePreview && form) {
        const contentDiv = document.getElementById('readme-content');
        if (contentDiv) {
          contentDiv.textContent = readmeContent;
        }
        readmePreview.style.display = 'block';
        form.style.display = 'none';
      }
    } catch (error) {
      showError('An error occurred. Please try again.');
      console.error(error);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Generate README';
      }
    }
  });
}

// GitHub connection
if (githubConnectBtn) {
  githubConnectBtn.addEventListener('click', async () => {
    githubConnectBtn.disabled = true;
    githubConnectBtn.textContent = 'Connecting...';

    try {
      const response = await fetch('/api/github/auth');
      const data = await response.json();

      if (data.url) {
        window.location.href = data.url;
      } else {
        // Show specific error message from API
        const errorMsg = data.error || 'Failed to initiate GitHub connection';
        const details = data.details ? ` - ${data.details}` : '';
        showError(errorMsg + details);
        githubConnectBtn.disabled = false;
        githubConnectBtn.textContent = 'Connect with GitHub';
        console.error('GitHub auth error:', data);
      }
    } catch (error) {
      showError('Failed to connect with GitHub. Check console for details.');
      githubConnectBtn.disabled = false;
      githubConnectBtn.textContent = 'Connect with GitHub';
      console.error(error);
    }
  });
}

// Check for GitHub token in URL
const urlParams = new URLSearchParams(window.location.search);
const githubToken = urlParams.get('githubToken');

if (githubToken) {
  currentGitHubToken = githubToken;
  // Remove token from URL
  window.history.replaceState({}, document.title, '/create');
  loadGitHubRepos();
}

async function loadGitHubRepos() {
  if (!currentGitHubToken || !githubConnectBtn) return;

  githubConnectBtn.disabled = true;
  githubConnectBtn.textContent = 'Loading repos...';

  try {
    const response = await fetch('/api/github/repos', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        accessToken: currentGitHubToken,
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      showError(data.error || 'Failed to fetch repositories');
      currentGitHubToken = null;
      return;
    }

    allRepos = data.repos;
    displayRepos(allRepos);

    if (githubConnectView && githubReposView) {
      githubConnectView.style.display = 'none';
      githubReposView.style.display = 'block';
    }
  } catch (error) {
    showError('Failed to load repositories');
    console.error(error);
  }
}

function displayRepos(repos: any[]) {
  if (!reposList) return;

  reposList.innerHTML = '';

  if (repos.length === 0) {
    reposList.innerHTML = '<p style="color: #aaa; text-align: center;">No repositories found</p>';
    return;
  }

  repos.forEach(repo => {
    const repoEl = document.createElement('div');
    repoEl.className = 'repo-item';
    repoEl.innerHTML = `
      <div class="repo-item-name">${repo.name}</div>
      ${repo.description ? `<div class="repo-item-desc">${repo.description}</div>` : ''}
      <div class="repo-item-meta">
        ${repo.language ? `<span>📝 ${repo.language}</span>` : ''}
        <span>👤 ${repo.owner}</span>
      </div>
    `;

    repoEl.addEventListener('click', () => {
      generateReadmeForRepo(repo);
    });

    reposList.appendChild(repoEl);
  });
}

async function generateReadmeForRepo(repo: any) {
  hideMessages();

  if (githubConnectBtn) githubConnectBtn.disabled = true;
  if (githubReposView) githubReposView.style.display = 'none';

  try {
    const response = await fetch('/api/repos/create-readme', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        githubUsername: repo.owner,
        repoName: repo.name,
        description: repo.description,
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      showError(data.error || 'Failed to generate README');
      if (githubReposView) githubReposView.style.display = 'block';
      return;
    }

    showSuccess('README generated successfully!');
    
    const readmeContent = data.readme;
    (window as any).currentReadme = readmeContent;
    (window as any).currentRepoName = repo.name;

    if (readmePreview) {
      const contentDiv = document.getElementById('readme-content');
      if (contentDiv) {
        contentDiv.textContent = readmeContent;
      }
      readmePreview.style.display = 'block';
    }
  } catch (error) {
    showError('An error occurred. Please try again.');
    console.error(error);
    if (githubReposView) githubReposView.style.display = 'block';
  }
}

// Disconnect GitHub
if (disconnectBtn) {
  disconnectBtn.addEventListener('click', () => {
    currentGitHubToken = null;
    allRepos = [];
    
    if (githubConnectView && githubReposView) {
      githubConnectView.style.display = 'block';
      githubReposView.style.display = 'none';
    }
    
    if (githubConnectBtn) {
      githubConnectBtn.disabled = false;
      githubConnectBtn.textContent = 'Connect with GitHub';
    }
    
    hideMessages();
  });
}

// Repo search
if (repoSearch) {
  repoSearch.addEventListener('input', (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allRepos.filter(repo =>
      repo.name.toLowerCase().includes(searchTerm) ||
      (repo.description && repo.description.toLowerCase().includes(searchTerm))
    );
    displayRepos(filtered);
  });
}

// Download README
if (downloadBtn) {
  downloadBtn.addEventListener('click', () => {
    const readme = (window as any).currentReadme;
    const repoName = (window as any).currentRepoName || (document.getElementById('repo-name') as HTMLInputElement)?.value || 'README';
    
    if (!readme) return;

    const element = document.createElement('a');
    element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(readme));
    element.setAttribute('download', `${repoName}.md`);
    element.style.display = 'none';
    document.body.appendChild(element);
    element.click();
    document.body.removeChild(element);

    showSuccess('README downloaded!');
  });
}

// Create another
if (createNewBtn) {
  createNewBtn.addEventListener('click', () => {
    // Reset based on current tab
    const activeTab = document.querySelector('.tab-btn.active')?.getAttribute('data-tab');
    
    if (activeTab === 'manual') {
      if (form) {
        form.reset();
        form.style.display = 'flex';
      }
    } else {
      if (githubReposView && currentGitHubToken) {
        githubReposView.style.display = 'block';
      }
    }
    
    if (readmePreview) readmePreview.style.display = 'none';
    hideMessages();
  });
}
</script>
