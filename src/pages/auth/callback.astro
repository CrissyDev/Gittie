---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
---

<MainLayout>
  <Navbar />
  <div style="display: flex; align-items: center; justify-content: center; height: 90vh; background: radial-gradient(circle at center, #0f2f2a, #050808);">
    <div style="text-align: center; color: white;">
      <h1>Completing sign up...</h1>
      <p style="color: #aaa; margin-top: 20px;">Please wait while we process your account.</p>
    </div>
  </div>
</MainLayout>

<script>
  // This page handles OAuth callback
  // In a real implementation, you would:
  // 1. Exchange the code for a session
  // 2. Store the session
  // 3. Redirect to dashboard
  
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');
  const error = params.get('error');

  if (error) {
    // Handle error
    console.error('OAuth error:', error);
    setTimeout(() => {
      window.location.href = '/signup';
    }, 2000);
  } else if (code) {
    // Exchange code for session (implement in your backend)
    console.log('OAuth code received:', code);
    setTimeout(() => {
      window.location.href = '/'; // Redirect to dashboard or home
    }, 2000);
  } else {
    // No code or error, redirect back
    window.location.href = '/signup';
  }
</script>
